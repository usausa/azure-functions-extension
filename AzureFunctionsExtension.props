<Project>

  <!-- The Worker SDK source generators cannot see the functions generated by AzureFunctionsExtension -->
  <PropertyGroup>
    <FunctionsEnableWorkerIndexing Condition="'$(FunctionsEnableWorkerIndexing)' == ''">false</FunctionsEnableWorkerIndexing>
    <FunctionsEnableExecutorSourceGen Condition="'$(FunctionsEnableExecutorSourceGen)' == ''">false</FunctionsEnableExecutorSourceGen>
  </PropertyGroup>

</Project>
